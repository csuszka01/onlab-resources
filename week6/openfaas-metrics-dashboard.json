{
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "rate(gateway_function_invocation_total{job=\"federate\"}[20s])",
          "legendFormat": "{{function_name}} ({{code}})",
          "refId": "A"
        }
      ],
      "title": "Function Invocations (Federated)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "gateway_service_count{job=\"federate\"}",
          "legendFormat": "{{function_name}}",
          "refId": "A"
        }
      ],
      "title": "Replica Count (Scaling)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (function_name) (rate(gateway_functions_seconds_sum{job=\"federate\"}[1m])) / sum by (function_name) (rate(gateway_functions_seconds_count{job=\"federate\"}[1m]))",
          "legendFormat": "{{function_name}}",
          "refId": "A"
        }
      ],
      "title": "Average Execution Time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 10,
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "Node CPU Load",
          "refId": "A"
        }
      ],
      "title": "RESEARCH: Node CPU Usage",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "title": "OpenFaaS Federated Research",
  "uid": "faas-res-01"
}
